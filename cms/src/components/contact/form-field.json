{
  "collectionName": "components_contact_form_fields",
  "info": {
    "displayName": "Form field"
  },
  "options": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 50,
      "regex": "^[a-z][a-z0-9_-]*$"
    },
    "label": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 100
    },
    "type": {
      "type": "enumeration",
      "enum": ["text", "email", "tel", "textarea"],
      "default": "text",
      "required": true
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "placeholder": {
      "type": "string",
      "maxLength": 200
    },
    "maxLength": {
      "type": "integer",
      "min": 1,
      "max": 5000,
      "default": 500
    }
  }
}
