{
  "kind": "singleType",
  "collectionName": "homes",
  "info": {
    "singularName": "home",
    "pluralName": "homes",
    "displayName": "Home"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "logoText": {
      "type": "string",
      "maxLength": 100
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "heading": {
      "type": "string"
    },
    "subheading": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "primaryCTA": {
      "type": "component",
      "repeatable": false,
      "component": "home.cta"
    },
    "secondaryCTA": {
      "type": "component",
      "repeatable": false,
      "component": "home.cta"
    },
    "primaryColor": {
      "type": "string",
      "maxLength": 32
    },
    "secondaryColor": {
      "type": "string",
      "maxLength": 32
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "seoImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "sections": {
      "type": "dynamiczone",
      "components": ["page.hero", "page.content", "page.gallery"]
    }
  }
}
