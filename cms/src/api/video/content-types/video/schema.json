{
  "kind": "collectionType",
  "collectionName": "videos",
  "info": {
    "singularName": "video",
    "pluralName": "videos",
    "displayName": "Video"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 150
    },
    "description": {
      "type": "text",
      "maxLength": 2000
    },
    "youtubeUrl": {
      "type": "string",
      "required": true,
      "maxLength": 2048,
      "regex": "^https://"
    },
    "youtubeEmbedCode": {
      "type": "text",
      "maxLength": 5000
    }
  }
}
