{
  "kind": "collectionType",
  "collectionName": "music",
  "info": {
    "singularName": "music",
    "pluralName": "musics",
    "displayName": "Music"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 150
    },
    "description": {
      "type": "text",
      "maxLength": 2000
    },
    "bandcampUrl": {
      "type": "string",
      "maxLength": 2048,
      "regex": "^https://"
    },
    "soundcloudUrl": {
      "type": "string",
      "maxLength": 2048,
      "regex": "^https://"
    }
  }
}
