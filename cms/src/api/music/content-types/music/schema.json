{
  "kind": "collectionType",
  "collectionName": "music",
  "info": {
    "singularName": "music",
    "pluralName": "musics",
    "displayName": "Music"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 150
    },
    "artist": {
      "type": "string",
      "maxLength": 150
    },
    "description": {
      "type": "richtext"
    },
    "releaseDate": {
      "type": "date"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "bandcampUrl": {
      "type": "string",
      "maxLength": 2048,
      "regex": "^https://"
    },
    "soundcloudUrl": {
      "type": "string",
      "maxLength": 2048,
      "regex": "^https://"
    }
  }
}
